#include <Servo.h>  // Include the Servo motor library

// Create a Servo object named doorServo
Servo doorServo;

// Define the Arduino pins used for the servo and buzzer
#define SERVO_PIN 9
#define BUZZER_PIN 8

// Set the correct password
String password = "1234";

// Variable to store the password entered by the user
String enteredPassword = "";

void setup()
{
  // Start serial communication at 9600 baud rate
  // Bluetooth modules such as HC-05 can communicate using Serial
  Serial.begin(9600);

  // Connect the servo motor to digital pin 9
  doorServo.attach(SERVO_PIN);

  // Set the buzzer pin as an OUTPUT
  pinMode(BUZZER_PIN, OUTPUT);

  // Set the servo to 0 degrees
  // This is the locked position of the door
  doorServo.write(0);

  // Display the project title
  Serial.println("=== BLUETOOTH DOOR LOCK ===");
  delay(500);

  // Display system status
  Serial.println("System Ready");
  delay(500);

  // Ask the user to enter the password
  Serial.println("Step 1: Enter password");
  Serial.println("Type password and press #");
  Serial.println("Example: 1234#");
}

void loop()
{
  // Check whether data has been received through Serial/Bluetooth
  if (Serial.available())
  {
    // Read one character from the Serial input
    char data = Serial.read();

    // Ignore Enter/newline characters
    // '\n' = New Line
    // '\r' = Carriage Return
    if (data == '\n' || data == '\r')
    {
      return;
    }

    // '#' is used to indicate that password entry is complete
    if (data == '#')
    {
      // Print a blank line
      Serial.println();

      // Inform the user that the password has been received
      Serial.println("Password received");
      Serial.println("Checking password...");

      // Wait for 1 second before checking
      delay(1000);

      // Compare the entered password with the correct password
      if (enteredPassword == password)
      {
        // Password is correct
        Serial.println("Password: CORRECT");
        Serial.println("ACCESS GRANTED");

        delay(500);

        // Start unlocking the door
        Serial.println("Door unlocking...");

        // Move servo to 90 degrees
        // This is the unlocked position
        doorServo.write(90);

        delay(500);

        // Inform the user that the door is unlocked
        Serial.println("Door UNLOCKED");

        // Keep the door unlocked for 5 seconds
        delay(5000);

        Serial.println("5 seconds completed");
        Serial.println("Locking door...");

        // Move servo back to 0 degrees
        // This locks the door again
        doorServo.write(0);

        delay(500);

        // Confirm that the door is locked
        Serial.println("Door LOCKED");
      }
      else
      {
        // Password is incorrect
        Serial.println("Password: WRONG");
        Serial.println("ACCESS DENIED");

        // Inform the user that the buzzer will turn ON
        Serial.println("Buzzer ON");

        // Turn the buzzer ON
        digitalWrite(BUZZER_PIN, HIGH);

        // Keep the buzzer ON for 1 second
        delay(1000);

        // Turn the buzzer OFF
        digitalWrite(BUZZER_PIN, LOW);

        // Confirm that the buzzer is OFF
        Serial.println("Buzzer OFF");
      }

      // Clear the previously entered password
      // This allows the user to enter a new password
      enteredPassword = "";

      // Ask the user to enter the password again
      Serial.println();
      Serial.println("Step 1: Enter password");
      Serial.println("Type password and press #");
    }
    else
    {
      // Add the received character to the entered password
      enteredPassword += data;

      // Display the entered password as asterisks (*)
      // This hides the actual password from the Serial Monitor
      Serial.print("Entered: ");

      // Loop through all entered characters
      for (int i = 0; i < enteredPassword.length(); i++)
      {
        // Print * instead of showing the actual password
        Serial.print("*");
      }

      Serial.println();

      // Display which digit should be entered next
      Serial.print("Next digit: ");

      // length() gives the number of characters already entered
      // +1 indicates the position of the next digit
      Serial.println(enteredPassword.length() + 1);
    }
  }
}
